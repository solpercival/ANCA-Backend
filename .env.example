# ---- API ----
APP_ENV=local
LOG_LEVEL=INFO
# behind an HTTPS reverse proxy: the proxy's address (comma-separated IPs or CIDRs).
# The orchestrator then trusts its X-Forwarded-For / X-Forwarded-Proto headers.
# Leave unset without a proxy. docker-compose.https.yml sets it for its Caddy proxy
# FORWARDED_ALLOW_IPS=172.31.250.10
ESCALATION_SUGGESTION_ENABLED=true
# alarm severity categories treated as safety-related (verify-before-acting note for
# all tiers, escalation prompt for operators); a JSON list, case-insensitive.
# Default is ["Fatal"]; uncomment to widen. Keep the single quotes: scripts/bench.sh
# sources this file in bash, which would otherwise strip the inner double quotes
# SAFETY_SEVERITY_CATEGORIES='["Fatal","Critical"]'

# ---- OAuth2 / auth ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
# true: /resolve and /feedback without a bearer token answer as an operator (the
# narrowest tier: no likely causes, no chat). A token that is sent must still be
# valid, and /chat always needs one. Turn it on for a front end that lets operators
# look up an alarm without logging in (e.g. the Vite dev server on 5173)
ALLOW_ANONYMOUS_OPERATOR=false
# browser origins allowed to call the API; a JSON list. 5173 is the Vite dev server.
# Keep the single quotes (see SAFETY_SEVERITY_CATEGORIES above)
CORS_ALLOW_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# ---- Postgres (relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=change_in_prod
POSTGRES_PASSWORD=change_in_prod

# ---- Redis (session + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# reuse a generated /resolve answer when the same prompt goes to the same model again
# (kept RESPONSE_TTL seconds). Leave off while running the eval: it hides run-to-run variation
RESPONSE_CACHE_ENABLED=false
RESPONSE_TTL=86400

# ---- Model provider selection ----
LLM_PROVIDER=ollama

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
# query-time embedding context; lower = less VRAM (Ollama default 4096 ~ 2.4 GB)
EMBEDDING_NUM_CTX=1024
# query embedder layers on GPU; 0 = CPU (frees ~1.4 GB VRAM; ingestion still uses GPU)
EMBEDDING_NUM_GPU=0
EMBEDDING_MODEL=qwen3-embedding:0.6b
# qwen3:8b gave the most complete fixes on the eval (1.5-2.8 s per answer on an RTX 4070,
# about 6 GB of GPU memory). Less GPU memory? qwen3:4b-instruct-2507-q4_K_M (after
# `ollama pull` it). No GPU? qwen3:1.7b or a similar small model, for CPU latency
LLM_MODEL=qwen3:8b
# model that rewrites follow-up /chat messages into standalone queries; empty = LLM_MODEL
REWRITE_MODEL=
# caps generated tokens at the default (medium) effort; the single biggest CPU-side latency lever
LLM_NUM_PREDICT=180
# 0 = repeatable answers (same alarm + docs -> same steps); raise for more varied wording
LLM_TEMPERATURE=0
GENERATION_CONNECT_TIMEOUT_SECONDS=5
GENERATION_READ_TIMEOUT_SECONDS=180
# repeatable answers: temperature 0 + fixed seed (on for resolve, off for chat)
RESOLVE_DETERMINISTIC=true
CHAT_DETERMINISTIC=false
DETERMINISTIC_TEMPERATURE=0
DETERMINISTIC_SEED=42

# ---- OpenAI-compatible providers ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- Anthropic / Claude ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# ---- Retrieval ----
# unified = embedding search only. dual = also keyword-weighted (sparse) search, fused
# with it; needs `make sparse` running and a `make reingest` so chunks get sparse vectors
EMBEDDING_SETUP=unified
# where the sparse embedding container answers from inside the compose network
TEI_ENDPOINT=http://tei:80
RETRIEVAL_TOP_K=50
# none = keep fused retrieval order; qwen3 = Qwen3-Reranker cross-encoder (GPU if visible)
RERANK_PROVIDER=qwen3
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# pairs per reranker forward pass; lower = less GPU memory, same scores
RERANK_BATCH_SIZE=5
# qwen3 only: tokens per query+chunk pair; longer chunks are scored on their beginning alone.
# Lower = less GPU memory, but long tables get judged by their header rows.
RERANK_MAX_LENGTH=2048
# qwen3 only: drop chunks with relevance probability below this (best chunk always kept); 0 = off
RERANK_MIN_SCORE=0.02
# qwen3 only: a cutoff that adapts to each query. Past the first RERANK_MIN_KEEP chunks,
# a chunk is kept only if it scores at least this fraction of the best chunk's score
# (and passes RERANK_MIN_SCORE). With 0.2: best 0.93, rest <=0.10 -> the rest is dropped;
# all chunks 0.70-0.96 -> all kept. 0 = off (absolute floor only)
RERANK_RELATIVE_MIN=0.2
# qwen3 only: chunks always kept from the top of the ranking, whatever they score (min 1)
RERANK_MIN_KEEP=2
# qwen3 only: if even the best chunk scores below this, /resolve answers "not covered"
# without calling the model (no steps built from unrelated docs); 0 = off
RESOLVE_MIN_RELEVANCE=0.1
# drop a resolve step when less than this share of its key words is in the context it
# was generated from (an invented step); 0 = off
STEP_SUPPORT_MIN=0.5
RERANK_TOP_N=8
RRF_K=60

# ---- Public access: Tailscale Funnel (`make funnel`, README) ----
# a reusable auth key tagged tag:anca-api, from the Tailscale admin console. Secret
# TS_AUTHKEY=
# the machine name on the tailnet: the API is served at https://<this>.<tailnet>.ts.net
# TS_HOSTNAME=anca-api

# ---- Hugging Face ----
# optional: only the `sparse` profile's tei container uses it, to download its model
HF_TOKEN=

# ---- Langfuse (runtime observability) ----
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
