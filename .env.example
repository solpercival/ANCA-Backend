# ---- API ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- OAuth2 / auth ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---- Postgres (relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=change_in_prod
POSTGRES_PASSWORD=change_in_prod

# ---- Redis (session + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Model provider selection ----
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
# query-time embedding context; lower = less VRAM (Ollama default 4096 ~ 2.4 GB)
EMBEDDING_NUM_CTX=1024
# query embedder layers on GPU; 0 = CPU (frees ~1.4 GB VRAM; ingestion still uses GPU)
EMBEDDING_NUM_GPU=0
EMBEDDING_MODEL=qwen3-embedding:0.6b
# no GPU on the demo machine? swap to qwen3:1.7b (or similar small model) for CPU latency
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# caps generated tokens; the single biggest CPU-side latency lever
LLM_NUM_PREDICT=180
GENERATION_CONNECT_TIMEOUT_SECONDS=5
GENERATION_READ_TIMEOUT_SECONDS=180

# ---- OpenAI-compatible providers ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- Anthropic / Claude ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# ---- Retrieval ----
RETRIEVAL_TOP_K=50
# none = keep fused retrieval order; qwen3 = Qwen3-Reranker cross-encoder (GPU if visible)
RERANK_PROVIDER=qwen3
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# pairs per reranker forward pass; lower = less GPU memory, same scores
RERANK_BATCH_SIZE=5
# qwen3 only: drop chunks with relevance probability below this (best chunk always kept); 0 = off
RERANK_MIN_SCORE=0
RERANK_TOP_N=8
RRF_K=60
BM25_INDEX_DIR=/var/lib/rag/bm25

# ---- Langfuse (runtime observability) ----
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
