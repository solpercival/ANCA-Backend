# ---- API ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- OAuth2 / auth ----
# Outside APP_ENV=local, use a random value of 32+ characters: openssl rand -hex 32
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=anca-rag-engine
JWT_AUDIENCE=anca-frontend
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_IDLE_DAYS=7
SESSION_MAX_DAYS=30
AUTH_ALLOW_REGISTRATION=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Postgres (relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=change_in_prod
POSTGRES_PASSWORD=change_in_prod

# ---- Redis (session + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Model provider selection ----
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3:567m
LLM_MODEL=qwen3:4b

# ---- OpenAI-compatible providers ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- Anthropic / Claude ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# ---- Retrieval ----
RETRIEVAL_TOP_K=50
RERANK_TOP_N=8
RERANK_PROVIDER=none
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RRF_K=60

# ---- Embeddings ----
TEI_ENDPOINT=http://localhost:7100
EMBEDDING_PROVIDER=tei
EMBEDDING_SETUP=dual
HF_TOKEN=

# ---- Langfuse (runtime observability) ----
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
