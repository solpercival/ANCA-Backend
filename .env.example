# ---- API ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- OAuth2 / auth ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---- Postgres (relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

# ---- Redis (session + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Model servers (OpenAI-compatible endpoints, hosted locally) ----
EMBEDDING_BASE_URL=http://embedding-server:8000/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_BASE_URL=http://embedding-server:8000/v1
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
LLM_BASE_URL=http://response-server:8000/v1
LLM_MODEL=Qwen/Qwen3-4B-Instruct

# ---- Retrieval ----
RETRIEVAL_TOP_K=50
RERANK_TOP_N=8
RRF_K=60

# ---- Langfuse (runtime observability) ----
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
