# ---- API ----
APP_ENV=local
LOG_LEVEL=INFO
# alarm severity categories treated as safety-related (verify-before-acting note for
# all tiers, escalation prompt for operators); a JSON list, case-insensitive.
# Default is ["Fatal"]; uncomment to widen. Keep the single quotes: scripts/bench.sh
# sources this file in bash, which would otherwise strip the inner double quotes
# SAFETY_SEVERITY_CATEGORIES='["Fatal","Critical"]'

# ---- OAuth2 / auth ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---- Postgres (relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=change_in_prod
POSTGRES_PASSWORD=change_in_prod

# ---- Redis (session + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# reuse a generated /resolve answer when the same prompt goes to the same model again
# (kept RESPONSE_TTL seconds). Leave off while running the eval: it hides run-to-run variation
RESPONSE_CACHE_ENABLED=false
RESPONSE_TTL=86400

# ---- Model provider selection ----
LLM_PROVIDER=ollama

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
# query-time embedding context; lower = less VRAM (Ollama default 4096 ~ 2.4 GB)
EMBEDDING_NUM_CTX=1024
# query embedder layers on GPU; 0 = CPU (frees ~1.4 GB VRAM; ingestion still uses GPU)
EMBEDDING_NUM_GPU=0
EMBEDDING_MODEL=qwen3-embedding:0.6b
# no GPU on the demo machine? swap to qwen3:1.7b (or similar small model) for CPU latency
# 12 GB of GPU memory or more? qwen3:8b (after `ollama pull qwen3:8b`) gave more complete
# fixes and shorter answers on the eval, at 1.5-2.8 s per answer on an RTX 4070
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# caps generated tokens at the default (medium) effort; the single biggest CPU-side latency lever
LLM_NUM_PREDICT=180
# 0 = repeatable answers (same alarm + docs -> same steps); raise for more varied wording
LLM_TEMPERATURE=0
GENERATION_CONNECT_TIMEOUT_SECONDS=5
GENERATION_READ_TIMEOUT_SECONDS=180

# ---- OpenAI-compatible providers ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- Anthropic / Claude ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# ---- Retrieval ----
RETRIEVAL_TOP_K=50
# none = keep fused retrieval order; qwen3 = Qwen3-Reranker cross-encoder (GPU if visible)
RERANK_PROVIDER=qwen3
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# pairs per reranker forward pass; lower = less GPU memory, same scores
RERANK_BATCH_SIZE=5
# qwen3 only: tokens per query+chunk pair; longer chunks are scored on their beginning alone.
# Lower = less GPU memory, but long tables get judged by their header rows.
RERANK_MAX_LENGTH=2048
# qwen3 only: drop chunks with relevance probability below this (best chunk always kept); 0 = off
RERANK_MIN_SCORE=0.02
# qwen3 only: a cutoff that adapts to each query. Past the first RERANK_MIN_KEEP chunks,
# a chunk is kept only if it scores at least this fraction of the best chunk's score
# (and passes RERANK_MIN_SCORE). With 0.2: best 0.93, rest <=0.10 -> the rest is dropped;
# all chunks 0.70-0.96 -> all kept. 0 = off (absolute floor only)
RERANK_RELATIVE_MIN=0.2
# qwen3 only: chunks always kept from the top of the ranking, whatever they score (min 1)
RERANK_MIN_KEEP=2
# qwen3 only: if even the best chunk scores below this, /resolve answers "not covered"
# without calling the model (no steps built from unrelated docs); 0 = off
RESOLVE_MIN_RELEVANCE=0.1
# drop a resolve step when less than this share of its key words is in the context it
# was generated from (an invented step); 0 = off
STEP_SUPPORT_MIN=0.5
RERANK_TOP_N=8
RRF_K=60

# ---- Langfuse (runtime observability) ----
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
